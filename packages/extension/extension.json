{
  "id": "builtin.language-features-html",
  "name": "Language Features HTML",
  "description": "Provides rich language support for HTML files",
  "icon": "icon.png",
  "activation": [
    "onCompletion:html",
    "onTabCompletion:html",
    "onLanguage:html",
    "onLanguage:handlebars",
    "onClosingTag:html",
    "onDefinition:html"
  ],
  "browser": "dist/languageFeaturesHtmlMain.js",
  "isolated": true,
  "completionProviders": [
    {
      "id": "html.provideCompletions.html",
      "languageId": "html"
    }
  ],
  "languages": [
    {
      "id": "html",
      "extensions": [
        ".html"
      ]
    }
  ],
  "commands": [
    {
      "id": "html.wrapTag",
      "label": "Html: Wrap Tag"
    }
  ],
  "keybindings": [
    {
      "key": "alt+w",
      "command": "html.wrapTag"
    }
  ],
  "repository": "https://github.com/lvce-editor/language-features-html"
}
